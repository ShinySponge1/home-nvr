# Copy to .env only to override Compose defaults; never commit actual secrets.
COMPOSE_PROJECT_NAME=home-nvr
FRIGATE_IMAGE=ghcr.io/blakeblackshear/frigate:0.18.2@sha256:fd60f99ffd4eb6c42360ed4e14953e270586f239309ab3983e55b2e97ffac09a
FRIGATE_SECURITY_IMAGE=home-nvr-frigate:0.18.2-security.1
# Only used with -f compose.gpu.yaml and bootstrap --hardware nvidia.
FRIGATE_GPU_IMAGE=ghcr.io/blakeblackshear/frigate:0.18.2-tensorrt@sha256:1cafb6ebbaff0aaf275cc3f31951bcf7e29f3989f18a10ba9565091367d8736c
FRIGATE_GPU_SECURITY_IMAGE=home-nvr-frigate:0.18.2-tensorrt-security.1
FRIGATE_HTTP_PORT=18971
FRIGATE_SHM_SIZE=512mb
# Choose storage explicitly for production, independent of the OS/vendor.
FRIGATE_MEDIA_PATH=./data/media
# Evidence viewer; loopback only until private remote access is configured.
CONTEXT_HTTP_PORT=8090
# Optional AI downloads no model until scripts/setup_models.py is explicitly run.
# Set ai.enabled and ai.model in the camera inventory, not an independent model
# environment variable, so Frigate and the gateway use the same exact tag.
OLLAMA_IMAGE=ollama/ollama:0.40.13@sha256:b2f0122c476bc9fe7ce679d8bb4bd555351e25e2554eefb156f61cb0a89cf429
OLLAMA_SECURITY_IMAGE=home-nvr-ollama:0.40.13-security.1
