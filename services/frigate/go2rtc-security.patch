+func TestContentLengthValidation(t *testing.T) {
+	tests := []struct {
+		name    string
+		message string
+		request bool
+	}{
+		{
+			name:    "negative request",
+			message: "OPTIONS rtsp://127.0.0.1/stream RTSP/1.0\r\nContent-Length: -1\r\n\r\n",
+			request: true,
+		},
+		{
+			name:    "negative response",
+			message: "RTSP/1.0 200 OK\r\nContent-Length: -1\r\n\r\n",
+		},
+		{
+			name:    "malformed response",
+			message: "RTSP/1.0 200 OK\r\nContent-Length: invalid\r\n\r\n",
+		},
+		{
+			name:    "oversized response",
+			message: "RTSP/1.0 200 OK\r\nContent-Length: 16777217\r\n\r\n",
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			reader := bufio.NewReader(bytes.NewBufferString(test.message))
+			var err error
+			if test.request {
+				_, err = ReadRequest(reader)
+			} else {
+				_, err = ReadResponse(reader)
+			}
+			if err == nil {
+				t.Fatal("expected invalid Content-Length to be rejected")
+			}
+		})
+	}
+}
+
+func TestContentLengthBody(t *testing.T) {
+	reader := bufio.NewReader(bytes.NewBufferString("RTSP/1.0 200 OK\r\nContent-Length: 4\r\n\r\ntest"))
+	response, err := ReadResponse(reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(response.Body) != "test" {
+		t.Fatalf("unexpected response body: %q", response.Body)
+	}
+}
